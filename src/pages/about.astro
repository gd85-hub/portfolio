---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = `About - ${site.name}`;
const description = 'About Gleb Dvoryatkin, a product designer creating complex digital products, interfaces, and systems shaped by experience in marketing and research.';
---

<BaseLayout title={title} description={description}>
  <main>
    <article class="mx-auto max-w-[56rem] px-5 pb-24 pt-12 sm:px-8 sm:pt-16 md:pt-20">
      <div class="reveal grid items-start gap-10 md:grid-cols-[13rem_minmax(0,1fr)] md:gap-12">
        <img
          src="/gleb-photo-light.png"
          alt={`Portrait of ${site.name}`}
          width="256"
          height="256"
          loading="eager"
          decoding="async"
          class="block h-40 w-40 shrink-0 rounded-full object-cover ring-1 ring-line dark:hidden md:h-52 md:w-52"
        />
        <img
          src="/gleb-photo-dark.png"
          alt={`Portrait of ${site.name}`}
          width="256"
          height="256"
          loading="eager"
          decoding="async"
          class="hidden h-40 w-40 shrink-0 rounded-full object-cover ring-1 ring-white/[0.06] dark:block md:h-52 md:w-52"
        />

        <div class="max-w-[60ch]">
          <h1 class="t-title text-ink">About</h1>
          <div class="mt-6 space-y-5">
            <p class="t-lede text-body">I design complex digital products, from trading platforms and sales analytics to educational tools. My work spans the entire design process, from understanding the problem and shaping the product to designing interfaces and systems that hold it all together.</p>
            <p class="t-body text-body">Before moving into product design, I spent a decade primarily in marketing, with research and project management also part of my work. That experience still shapes how I approach problems, make decisions, and collaborate with teams.</p>
            <p class="t-body text-body">Outside work, I'm into music, sports, and travel. I've played guitar in several bands, including traditional Irish music. I also enjoy training and discovering new places.</p>
          </div>

          <a href="/resume" class="group mt-8 inline-flex items-center gap-1.5 t-body font-medium text-ink">
            <span class="link-underline">View resume</span>
            <span class="icon [transition:transform_420ms_var(--ease-out)] group-hover:translate-x-1">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </a>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
