---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = `About - ${site.name}`;
const description = 'Gleb Dvoryatkin, a product designer for data-dense tools, with ten years in marketing and research behind the design work.';
---

<BaseLayout title={title} description={description}>
  <main>
    <article class="mx-auto max-w-content px-5 pb-24 pt-16 sm:px-8 sm:pt-24">
      <div class="reveal flex flex-col items-start gap-10">
        <img
          src="/gleb-photo-light.png"
          alt={`Portrait of ${site.name}`}
          width="256"
          height="256"
          loading="eager"
          decoding="async"
          class="block h-40 w-40 shrink-0 rounded-full object-cover ring-1 ring-line dark:hidden sm:h-52 sm:w-52"
        />
        <img
          src="/gleb-photo-dark.png"
          alt={`Portrait of ${site.name}`}
          width="256"
          height="256"
          loading="eager"
          decoding="async"
          class="hidden h-40 w-40 shrink-0 rounded-full object-cover ring-1 ring-white/[0.06] dark:block sm:h-52 sm:w-52"
        />

        <div class="max-w-[60ch] space-y-5">
          <h1 class="t-lede text-ink">I'm Gleb, a product designer. I work on data-dense tools, the kind where someone has to read a screen full of data and still make the right call.</h1>
          <p class="t-body text-body">Before design, I spent ten years in marketing, research, and project management. So I read a product from both ends: the business behind it and the person using it.</p>
          <p class="t-body text-body">I design dashboards, analytics, and back-office tools, plus the design systems that hold them together. The real work is in the parts most people skip: the edge case, the empty state, the moment something breaks.</p>
          <p class="t-body text-body">Off the clock: guitar, boxing, books, astrophysics. Three languages so far: English, French, Russian.</p>
        </div>
      </div>

      <footer class="reveal mt-14 border-t border-line pt-10 dark:border-white/[0.07] sm:mt-16">
        <a href="/resume" class="group t-body inline-flex items-center gap-1.5 font-medium text-ink">
          <span class="link-underline">For the full track record, see my resume</span>
          <span class="icon [transition:transform_420ms_var(--ease-out)] group-hover:translate-x-1">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>
