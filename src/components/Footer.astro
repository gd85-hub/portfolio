---
import CopyEmail from './CopyEmail.astro';
import { site } from '../data/site';

const { email, telegramUrl, linkedinUrl } = site;
---

<footer id="contact" class="scroll-mt-20 border-t border-line bg-[var(--footer-bg)] dark:border-white/[0.07]">
  <div class="mx-auto max-w-wide px-5 py-16 sm:px-8">
    <div class="max-w-[52ch]">
      <h2 class="t-title text-ink">Let's talk.</h2>
      <p class="t-lede mt-4 text-body">Always glad to talk. Open to new opportunities and collaborations.</p>
      <div class="mt-8 flex flex-wrap items-center gap-6 font-mono">
        <CopyEmail email={email} class="t-body text-accent" />
        <a href={telegramUrl} target="_blank" rel="noopener noreferrer" class="link-underline t-body text-accent">Telegram</a>
        <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="link-underline t-body text-accent">LinkedIn</a>
      </div>
    </div>

    <div class="mt-14 flex border-t border-line pt-8 text-[12px] text-muted dark:border-white/[0.07]">
      <a href="#top" data-back-to-top class="link-underline font-mono hover:text-ink">Back to top</a>
    </div>
  </div>

  <script is:inline>
    document.querySelector('[data-back-to-top]')?.addEventListener('click', (event) => {
      event.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  </script>
</footer>
