---
import Button from './Button.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;
const isWork = path === '/';
const isAbout = path === '/about' || path === '/about/';
const isResume = path === '/resume' || path === '/resume/';
---

<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <nav class="mx-auto flex h-16 max-w-content items-center justify-between px-5 sm:px-8">
    <a href="/" class="whitespace-nowrap font-mono text-[12px] font-medium leading-4 text-ink sm:text-[16px] sm:leading-6">{site.name}<span class="text-accent">.</span></a>
    <div class="flex items-center gap-4 t-body text-muted sm:gap-7">
      <a href="/#work" class="link-underline hover:text-ink" aria-current={isWork ? 'page' : undefined}>Work</a>
      <a href="/about" class="link-underline hover:text-ink" aria-current={isAbout ? 'page' : undefined}>About</a>
      <a href="/resume" class="link-underline hover:text-ink" aria-current={isResume ? 'page' : undefined}>Resume</a>
      <Button href="/#contact" variant="ghost" size="sm" class="magnetic-cta hidden sm:inline-flex">Let's talk</Button>
      <button id="theme-toggle" type="button" aria-label="Toggle theme" class="button-feedback grid h-8 w-8 place-items-center rounded-full border border-line text-ink hover:border-ink">
        <span class="theme-toggle-icon theme-toggle-icon-sun icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" /></svg>
        </span>
        <span class="theme-toggle-icon theme-toggle-icon-moon icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" /></svg>
        </span>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  const toggle = document.getElementById('theme-toggle');
  let themeTransitionTimer = 0;

  function readMotionMs(token){
    const raw = getComputedStyle(document.documentElement).getPropertyValue(token).trim();
    const value = Number.parseFloat(raw);

    if (!Number.isFinite(value)) return 0;
    return raw.endsWith('s') && !raw.endsWith('ms') ? value * 1000 : value;
  }

  function toggleTheme(){
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');

    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch(e){}
  }

  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    window.clearTimeout(themeTransitionTimer);

    if (reducedMotion) {
      root.classList.remove('theme-transition-active');
      toggleTheme();
      return;
    }

    root.classList.add('theme-transition-active');

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        toggleTheme();

        themeTransitionTimer = window.setTimeout(() => {
          root.classList.remove('theme-transition-active');
        }, readMotionMs('--motion-theme'));
      });
    });
  });

  const magneticCta = document.querySelector('.magnetic-cta');
  const magneticMedia = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (magneticCta instanceof HTMLElement && magneticMedia.matches && !reducedMotion) {
    let bounds = null;

    magneticCta.addEventListener('mouseenter', () => {
      bounds = magneticCta.getBoundingClientRect();
      magneticCta.classList.add('is-magnetic-tracking');
    });

    magneticCta.addEventListener('mousemove', (event) => {
      if (!bounds) return;

      const centerX = bounds.left + bounds.width / 2;
      const centerY = bounds.top + bounds.height / 2;
      const clamp = (value) => Math.max(-8, Math.min(8, value));

      magneticCta.style.setProperty('--magnetic-x', String(clamp((event.clientX - centerX) * 0.24)) + 'px');
      magneticCta.style.setProperty('--magnetic-y', String(clamp((event.clientY - centerY) * 0.24)) + 'px');
    });

    magneticCta.addEventListener('mouseleave', () => {
      bounds = null;
      magneticCta.classList.remove('is-magnetic-tracking');
      requestAnimationFrame(() => {
        magneticCta.style.setProperty('--magnetic-x', '0px');
        magneticCta.style.setProperty('--magnetic-y', '0px');
      });
    });
  }
</script>
