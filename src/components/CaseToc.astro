---
import type { HTMLAttributes } from 'astro/types';

type TocItem = {
  id: string;
  label: string;
};

type Props = HTMLAttributes<'nav'> & {
  toc: TocItem[];
};

const { toc, class: className, ...attrs } = Astro.props;
---

<nav
  data-case-toc
  aria-label="Case sections"
  class:list={['sticky top-16 z-30 border-b border-line bg-paper', className]}
  {...attrs}
>
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div data-toc-scroll class="overflow-x-auto">
      <div data-toc-track class="relative flex h-12 w-max min-w-full items-center gap-6 pr-5 sm:pr-8">
        {
          toc.map((item, index) => (
            <a
              href={`#${item.id}`}
              data-toc-link
              data-toc-id={item.id}
              aria-current={index === 0 ? 'true' : undefined}
              class:list={[
                'shrink-0 whitespace-nowrap t-small transition-[color] duration-[var(--motion-theme)] ease-[var(--ease-out)] hover:text-ink focus-visible:text-ink',
                index === 0 ? 'text-accent' : 'text-muted',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <span
          data-toc-indicator
          class="pointer-events-none absolute bottom-[2px] left-0 h-[2px] w-0 bg-accent transition-transform duration-[var(--motion-theme)] ease-[var(--ease-out)]"
          aria-hidden="true"
        ></span>
      </div>
    </div>
  </div>

  <span class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px]" aria-hidden="true">
    <span data-toc-progress class="block h-full w-0 bg-accent"></span>
  </span>
</nav>

<script>
  const tocRoots = document.querySelectorAll<HTMLElement>('[data-case-toc]');

  tocRoots.forEach((root) => {
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const scrollArea = root.querySelector<HTMLElement>('[data-toc-scroll]');
    const track = root.querySelector<HTMLElement>('[data-toc-track]');
    const indicator = root.querySelector<HTMLElement>('[data-toc-indicator]');
    const progress = root.querySelector<HTMLElement>('[data-toc-progress]');
    const items = links.map((link) => ({
      id: link.dataset.tocId ?? '',
    }));
    const sections = items
      .map((item) => document.getElementById(item.id))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);

    if (!scrollArea || !track || !indicator || !progress) return;

    let activeId = items[0]?.id ?? '';
    let progressFrame = 0;
    let layoutFrame = 0;

    const positionIndicator = (link: HTMLAnchorElement, revealLink = true) => {
      const trackRect = track.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      indicator.style.width = `${linkRect.width}px`;
      indicator.style.transform = `translateX(${linkRect.left - trackRect.left}px)`;

      if (revealLink && scrollArea.scrollWidth > scrollArea.clientWidth) {
        link.scrollIntoView({ behavior: 'auto', block: 'nearest', inline: 'center' });
      }
    };

    const setActive = (id: string, revealLink = true) => {
      const activeLink = links.find((link) => link.dataset.tocId === id);
      if (!activeLink) return;

      activeId = id;
      links.forEach((link) => {
        const active = link === activeLink;
        link.classList.toggle('text-accent', active);
        link.classList.toggle('text-muted', !active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
      positionIndicator(activeLink, revealLink);
    };

    const visibleSections = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!(entry.target instanceof HTMLElement)) return;
          if (entry.isIntersecting) visibleSections.add(entry.target.id);
          else visibleSections.delete(entry.target.id);
        });

        const activeSection = sections.find((section) => visibleSections.has(section.id));
        if (activeSection) setActive(activeSection.id);
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );

    sections.forEach((section) => observer.observe(section));

    const updateProgress = () => {
      const scrollRange = document.documentElement.scrollHeight - window.innerHeight;
      const value = scrollRange > 0 ? Math.min(Math.max(window.scrollY / scrollRange, 0), 1) : 0;
      progress.style.width = `${value * 100}%`;
      progressFrame = 0;
    };

    const requestProgressUpdate = () => {
      if (progressFrame) return;
      progressFrame = window.requestAnimationFrame(updateProgress);
    };

    const requestLayoutUpdate = () => {
      if (layoutFrame) return;
      layoutFrame = window.requestAnimationFrame(() => {
        const activeLink = links.find((link) => link.dataset.tocId === activeId);
        if (activeLink) positionIndicator(activeLink, false);
        updateProgress();
        layoutFrame = 0;
      });
    };

    links.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.dataset.tocId;
        if (id) setActive(id);
      });
    });

    window.addEventListener('scroll', requestProgressUpdate, { passive: true });
    window.addEventListener('resize', requestLayoutUpdate);

    const hashId = window.location.hash.slice(1);
    setActive(items.some((item) => item.id === hashId) ? hashId : activeId, false);
    updateProgress();
    document.fonts.ready.then(requestLayoutUpdate);
  });
</script>

<style>
  [data-toc-scroll] {
    scrollbar-width: none;
  }

  [data-toc-scroll]::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-toc-link],
    [data-toc-indicator] {
      transition: none !important;
    }
  }
</style>
