---
import type { HTMLAttributes } from 'astro/types';

type TocItem = {
  id: string;
  label: string;
};

type Props = HTMLAttributes<'nav'> & {
  toc: TocItem[];
};

const { toc, class: className, ...attrs } = Astro.props;
---

<nav
  data-case-toc-rail
  aria-label="Case contents"
  class:list={[
    'group fixed top-1/2 z-40 hidden -translate-y-1/2 flex-col gap-3 xl:flex',
    className,
  ]}
  style="left: calc(50% - 632px);"
  {...attrs}
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -inset-x-3 -inset-y-3 z-0 rounded-[var(--radius)] bg-paper opacity-0 shadow-lg transition-opacity duration-[var(--motion-fast)] ease-[var(--ease-out)] group-hover:opacity-100 group-focus-within:opacity-100"
  ></span>
  {
    toc.map((item, index) => (
      <a
        href={`#${item.id}`}
        data-case-toc-rail-link
        data-target={item.id}
        aria-current={index === 0 ? 'page' : undefined}
        class="group/item relative z-10 flex items-center gap-3 py-1"
      >
        <span
          data-tick
          class:list={[
            'h-[2px] rounded-full transition-[background-color,opacity,width] duration-[var(--motion-fast)] ease-[var(--ease-out)]',
            index === 0 ? 'w-6 bg-accent opacity-100' : 'w-4 bg-muted opacity-50',
          ]}
        ></span>
        <span
          data-label
          class:list={[
            't-small whitespace-nowrap opacity-0 transition-opacity duration-[var(--motion-fast)] ease-[var(--ease-out)] group-hover:opacity-100 group-focus-within:opacity-100',
            index === 0 ? 'text-ink' : 'text-muted',
          ]}
        >
          {item.label}
        </span>
      </a>
    ))
  }
</nav>

<nav
  data-case-toc-tabs
  aria-label="Case sections"
  class:list={['sticky top-16 z-30 w-full border-b border-line bg-paper xl:hidden', className]}
  {...attrs}
>
  <div
    data-tabs-track
    class="relative mx-auto flex justify-center gap-6 overflow-x-auto px-5 py-2 sm:px-8"
  >
    {
      toc.map((item, index) => (
        <a
          href={`#${item.id}`}
          data-case-toc-tab
          data-target={item.id}
          aria-current={index === 0 ? 'page' : undefined}
          class="t-small whitespace-nowrap py-1 text-muted transition-colors duration-[var(--motion-fast)] hover:text-ink aria-[current=page]:text-accent"
        >
          {item.label}
        </a>
      ))
    }
    <span
      data-tabs-indicator
      aria-hidden="true"
      class="pointer-events-none absolute bottom-0 left-0 h-[2px] w-0 bg-accent"
    ></span>
  </div>
</nav>

<script>
  const rail = document.querySelector<HTMLElement>('[data-case-toc-rail]');
  const tabs = document.querySelector<HTMLElement>('[data-case-toc-tabs]');
  const tabsTrack = tabs?.querySelector<HTMLElement>('[data-tabs-track]');
  const tabsIndicator = tabs?.querySelector<HTMLElement>('[data-tabs-indicator]');

  if (rail && tabs && tabsTrack && tabsIndicator) {
    const railLinks = Array.from(
      rail.querySelectorAll<HTMLAnchorElement>('[data-case-toc-rail-link]'),
    );
    const tabLinks = Array.from(
      tabsTrack.querySelectorAll<HTMLAnchorElement>('[data-case-toc-tab]'),
    );
    const allLinks = [...railLinks, ...tabLinks];
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const indicatorTransition =
      'transform var(--motion-theme) var(--ease-out), width var(--motion-theme) var(--ease-out)';
    let activeId = '';
    let resizeFrame = 0;

    const moveTabsIndicator = (link: HTMLAnchorElement, animate = true) => {
      tabsIndicator.style.transition = animate && !prefersReduced ? indicatorTransition : 'none';
      tabsIndicator.style.transform = `translateX(${link.offsetLeft}px)`;
      tabsIndicator.style.width = `${link.offsetWidth}px`;
    };

    const setActive = (id: string, animate = true, revealTab = true) => {
      const activeTab = tabLinks.find((link) => link.dataset.target === id);
      if (!activeTab) return;

      activeId = id;
      tabLinks.forEach((link) => {
        if (link === activeTab) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });

      railLinks.forEach((link) => {
        const active = link.dataset.target === id;
        const tick = link.querySelector<HTMLElement>('[data-tick]');
        const label = link.querySelector<HTMLElement>('[data-label]');

        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');

        tick?.classList.toggle('w-6', active);
        tick?.classList.toggle('w-4', !active);
        tick?.classList.toggle('bg-accent', active);
        tick?.classList.toggle('bg-muted', !active);
        tick?.classList.toggle('opacity-100', active);
        tick?.classList.toggle('opacity-50', !active);
        label?.classList.toggle('text-ink', active);
        label?.classList.toggle('text-muted', !active);
      });

      moveTabsIndicator(activeTab, animate);

      if (revealTab && tabsTrack.scrollWidth > tabsTrack.clientWidth) {
        activeTab.scrollIntoView({
          inline: 'center',
          block: 'nearest',
          behavior: prefersReduced ? 'auto' : 'smooth',
        });
      }
    };

    const sections = tabLinks
      .map((link) => document.getElementById(link.dataset.target ?? ''))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);
    const visibleSections = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!(entry.target instanceof HTMLElement)) return;
          if (entry.isIntersecting) visibleSections.add(entry.target.id);
          else visibleSections.delete(entry.target.id);
        });

        const activeSection = sections.find((section) => visibleSections.has(section.id));
        if (activeSection) setActive(activeSection.id);
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));

    allLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.dataset.target;
        if (id) setActive(id);
      });
    });

    const moveCurrentWithoutAnimation = () => {
      const activeTab = tabLinks.find((link) => link.dataset.target === activeId);
      if (activeTab) moveTabsIndicator(activeTab, false);
    };

    window.addEventListener('resize', () => {
      if (resizeFrame) return;
      resizeFrame = window.requestAnimationFrame(() => {
        moveCurrentWithoutAnimation();
        resizeFrame = 0;
      });
    });

    const hashId = window.location.hash.slice(1);
    const initialId = tabLinks.some((link) => link.dataset.target === hashId)
      ? hashId
      : tabLinks[0]?.dataset.target;

    if (initialId) setActive(initialId, false, false);

    window.requestAnimationFrame(() => {
      tabsIndicator.style.transition = prefersReduced ? 'none' : indicatorTransition;
    });
    document.fonts.ready.then(moveCurrentWithoutAnimation);
  }
</script>

<style>
  [data-tabs-track] {
    justify-content: safe center;
    scrollbar-width: none;
  }

  [data-tabs-track]::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-case-toc-rail] *,
    [data-case-toc-tabs] * {
      transition: none !important;
    }
  }
</style>
