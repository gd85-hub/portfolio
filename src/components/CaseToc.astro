---
import type { HTMLAttributes } from 'astro/types';

type TocItem = {
  id: string;
  label: string;
};

type Props = HTMLAttributes<'nav'> & {
  toc: TocItem[];
};

const { toc, class: className, ...attrs } = Astro.props;
---

<nav
  data-case-toc
  aria-label="Case sections"
  class:list={['sticky top-16 z-30 w-full border-b border-line bg-paper', className]}
  {...attrs}
>
  <div
    data-case-toc-track
    class="relative mx-auto flex justify-center gap-6 overflow-x-auto px-5 py-2 sm:px-8"
  >
    {
      toc.map((item, index) => (
        <a
          href={`#${item.id}`}
          data-case-toc-link
          aria-current={index === 0 ? 'page' : undefined}
          class="t-small whitespace-nowrap py-1 text-muted transition-colors duration-[var(--motion-fast)] hover:text-ink aria-[current=page]:text-accent"
        >
          {item.label}
        </a>
      ))
    }
    <span
      data-case-toc-indicator
      aria-hidden="true"
      class="pointer-events-none absolute bottom-0 left-0 h-[2px] w-0 bg-accent"
    ></span>
  </div>
</nav>

<script>
  const tocRoots = document.querySelectorAll<HTMLElement>('[data-case-toc]');

  tocRoots.forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-case-toc-track]');
    const indicator = root.querySelector<HTMLElement>('[data-case-toc-indicator]');
    if (!track || !indicator) return;

    const links = Array.from(track.querySelectorAll<HTMLAnchorElement>('[data-case-toc-link]'));
    if (links.length === 0) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const indicatorTransition =
      'transform var(--motion-theme) var(--ease-out), width var(--motion-theme) var(--ease-out)';
    let activeId = '';
    let resizeFrame = 0;

    const getLinkId = (link: HTMLAnchorElement) => link.getAttribute('href')?.slice(1) ?? '';

    const moveIndicator = (link: HTMLAnchorElement, animate = true) => {
      indicator.style.transition = animate && !prefersReduced ? indicatorTransition : 'none';
      indicator.style.transform = `translateX(${link.offsetLeft}px)`;
      indicator.style.width = `${link.offsetWidth}px`;
    };

    const setActive = (id: string, animate = true, revealLink = true) => {
      const activeLink = links.find((link) => getLinkId(link) === id);
      if (!activeLink) return;

      activeId = id;
      links.forEach((link) => {
        if (link === activeLink) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });

      moveIndicator(activeLink, animate);

      if (revealLink && track.scrollWidth > track.clientWidth) {
        activeLink.scrollIntoView({
          inline: 'center',
          block: 'nearest',
          behavior: prefersReduced ? 'auto' : 'smooth',
        });
      }
    };

    const sections = links
      .map((link) => document.getElementById(getLinkId(link)))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);
    const visibleSections = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!(entry.target instanceof HTMLElement)) return;
          if (entry.isIntersecting) visibleSections.add(entry.target.id);
          else visibleSections.delete(entry.target.id);
        });

        const activeSection = sections.find((section) => visibleSections.has(section.id));
        if (activeSection) setActive(activeSection.id);
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));

    links.forEach((link) => {
      link.addEventListener('click', () => setActive(getLinkId(link)));
    });

    const moveCurrentWithoutAnimation = () => {
      const activeLink = links.find((link) => getLinkId(link) === activeId);
      if (!activeLink) return;
      moveIndicator(activeLink, false);
    };

    window.addEventListener('resize', () => {
      if (resizeFrame) return;
      resizeFrame = window.requestAnimationFrame(() => {
        moveCurrentWithoutAnimation();
        resizeFrame = 0;
      });
    });

    const hashId = window.location.hash.slice(1);
    const initialId = links.some((link) => getLinkId(link) === hashId)
      ? hashId
      : getLinkId(links[0]);
    setActive(initialId, false, false);

    window.requestAnimationFrame(() => {
      indicator.style.transition = prefersReduced ? 'none' : indicatorTransition;
    });
    document.fonts.ready.then(moveCurrentWithoutAnimation);
  });
</script>

<style>
  [data-case-toc-track] {
    justify-content: safe center;
    scrollbar-width: none;
  }

  [data-case-toc-track]::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-case-toc-link] {
      transition: none !important;
    }
  }
</style>
