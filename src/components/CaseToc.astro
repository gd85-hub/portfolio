---
import type { HTMLAttributes } from 'astro/types';

type TocItem = {
  id: string;
  label: string;
};

type Props = HTMLAttributes<'nav'> & {
  toc: TocItem[];
};

const { toc, class: className, ...attrs } = Astro.props;
---

<div data-case-toc class="sticky top-16 z-30 flex w-full justify-center border-b border-line bg-paper px-5 py-2 sm:px-8">
  <nav
    data-toc-scroll
    aria-label="Case sections"
    class:list={[
      'w-fit max-w-full overflow-x-auto rounded-full border border-line bg-surface p-1',
      className,
    ]}
    {...attrs}
  >
    <div data-toc-track class="relative inline-flex w-max items-center gap-1">
      <span
        data-toc-thumb
        class="pointer-events-none absolute inset-y-0 left-0 z-0 w-px origin-left rounded-full bg-ph1 transition-transform duration-[var(--motion-theme)] ease-[var(--ease-out)]"
        aria-hidden="true"
      ></span>
      {
        toc.map((item, index) => (
          <a
            href={`#${item.id}`}
            data-toc-link
            data-toc-id={item.id}
            aria-current={index === 0 ? 'true' : undefined}
            class:list={[
              'relative z-10 shrink-0 whitespace-nowrap rounded-full px-3 py-1.5 t-small transition-[color] duration-[var(--motion-theme)] ease-[var(--ease-out)] hover:text-ink focus-visible:text-ink',
              index === 0 ? 'text-accent' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</div>

<script>
  const tocRoots = document.querySelectorAll<HTMLElement>('[data-case-toc]');

  tocRoots.forEach((root) => {
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const scrollArea = root.querySelector<HTMLElement>('[data-toc-scroll]');
    const thumb = root.querySelector<HTMLElement>('[data-toc-thumb]');
    const items = links.map((link) => ({ id: link.dataset.tocId ?? '' }));
    const sections = items
      .map((item) => document.getElementById(item.id))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);

    if (!scrollArea || !thumb) return;

    let activeId = items[0]?.id ?? '';
    let layoutFrame = 0;

    const positionThumb = (link: HTMLAnchorElement, revealLink = true) => {
      thumb.style.transform = `translateX(${link.offsetLeft}px) scaleX(${link.offsetWidth})`;

      if (revealLink && scrollArea.scrollWidth > scrollArea.clientWidth) {
        link.scrollIntoView({ behavior: 'auto', block: 'nearest', inline: 'center' });
      }
    };

    const setActive = (id: string, revealLink = true) => {
      const activeLink = links.find((link) => link.dataset.tocId === id);
      if (!activeLink) return;

      activeId = id;
      links.forEach((link) => {
        const active = link === activeLink;
        link.classList.toggle('text-accent', active);
        link.classList.toggle('text-muted', !active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
      positionThumb(activeLink, revealLink);
    };

    const visibleSections = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!(entry.target instanceof HTMLElement)) return;
          if (entry.isIntersecting) visibleSections.add(entry.target.id);
          else visibleSections.delete(entry.target.id);
        });

        const activeSection = sections.find((section) => visibleSections.has(section.id));
        if (activeSection) setActive(activeSection.id);
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );

    sections.forEach((section) => observer.observe(section));

    const requestLayoutUpdate = () => {
      if (layoutFrame) return;
      layoutFrame = window.requestAnimationFrame(() => {
        const activeLink = links.find((link) => link.dataset.tocId === activeId);
        if (activeLink) positionThumb(activeLink, false);
        layoutFrame = 0;
      });
    };

    links.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.dataset.tocId;
        if (id) setActive(id);
      });
    });

    window.addEventListener('resize', requestLayoutUpdate);

    const hashId = window.location.hash.slice(1);
    setActive(items.some((item) => item.id === hashId) ? hashId : activeId, false);
    document.fonts.ready.then(requestLayoutUpdate);
  });
</script>

<style>
  [data-toc-scroll] {
    scrollbar-width: none;
  }

  [data-toc-scroll]::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-toc-link],
    [data-toc-thumb] {
      transition: none !important;
    }
  }
</style>
