---
import type { HTMLAttributes } from 'astro/types';
import Eyebrow from './Eyebrow.astro';

type Props = Omit<HTMLAttributes<'a'>, 'role'> & {
  title: string;
  desc: string;
  role: string;
  cardMeta: string;
  cover?: string | null;
  coverLight?: string | null;
  coverDark?: string | null;
  coverLightHover?: string | null;
  coverDarkHover?: string | null;
};

const {
  title,
  desc,
  role,
  cardMeta,
  cover = null,
  coverLight = null,
  coverDark = null,
  coverLightHover = null,
  coverDarkHover = null,
  href = '#',
  class: className,
  ...attrs
} = Astro.props;

const hasThemed = Boolean(coverLight && coverDark);
const hasThemedHover = Boolean(coverLightHover && coverDarkHover);
const imgBase = 'absolute inset-0 h-full w-full object-cover object-top';
const imgHover = 'absolute inset-0 h-full w-full object-cover object-top opacity-0 [transition:opacity_900ms_var(--ease-out)] group-hover:opacity-100';
---

<a href={href} class:list={['reveal group flex flex-col overflow-hidden rounded-[var(--radius)] border border-line bg-surface dark:border-white/[0.07] dark:bg-[#0c0c0e]', className]} {...attrs}>
  <div class="relative aspect-[16/10] overflow-hidden">
    {
      hasThemed ? (
        <Fragment>
          <img src={coverLight} alt={`${title} cover`} width="1600" height="1000" loading="lazy" decoding="async" class:list={['block dark:hidden', imgBase]} />
          <img src={coverDark} alt={`${title} cover`} width="1600" height="1000" loading="lazy" decoding="async" class:list={['hidden dark:block', imgBase]} />
          {hasThemedHover && (
            <Fragment>
              <img src={coverLightHover} alt="" aria-hidden="true" width="1600" height="1000" loading="lazy" decoding="async" class:list={['block dark:hidden', imgHover]} />
              <img src={coverDarkHover} alt="" aria-hidden="true" width="1600" height="1000" loading="lazy" decoding="async" class:list={['hidden dark:block', imgHover]} />
            </Fragment>
          )}
        </Fragment>
      ) : cover ? (
        <img src={cover} alt={`${title} cover`} width="1600" height="1000" loading="lazy" decoding="async" class={imgBase} />
      ) : (
        <div class="ph absolute inset-0 flex items-center justify-center">
          <Eyebrow tone="ph" as="span">[ cover ]</Eyebrow>
        </div>
      )
    }
  </div>
  <div class="flex min-w-0 flex-1 flex-col border-t border-line p-6 sm:p-7 dark:border-white/[0.07] [transition:background-color_1000ms_var(--ease-out)] dark:group-hover:bg-white/[0.015]">
    <div class="flex items-center justify-between gap-4">
      <h3 class="t-section text-ink">{title}</h3>
      <span class="icon shrink-0 text-ink [transition:transform_420ms_var(--ease-out)] group-hover:translate-x-1" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    </div>
    <p class="mt-3 line-clamp-2 t-body text-body">{desc}</p>
    <p class="mt-4 t-small font-mono text-muted">{role} &middot; {cardMeta}</p>
    <span class="sr-only">Read case</span>
  </div>
</a>
