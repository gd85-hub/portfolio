---
import type { HTMLAttributes } from 'astro/types';
import Eyebrow from './Eyebrow.astro';

type Props = Omit<HTMLAttributes<'a'>, 'role'> & {
  kicker: string;
  title: string;
  desc: string;
  time: string;
  role: string;
  cover?: string | null;
  coverLight?: string | null;
  coverDark?: string | null;
};

const {
  kicker,
  title,
  desc,
  time,
  role,
  cover = null,
  coverLight = null,
  coverDark = null,
  href = '#',
  class: className,
  ...attrs
} = Astro.props;

const hasThemed = Boolean(coverLight && coverDark);
const imgClass = 'absolute inset-0 h-full w-full object-cover object-top transition-transform duration-[var(--motion-hover)] ease-[var(--ease-out)] group-hover:scale-[1.03]';
---

<a href={href} class:list={['reveal group flex flex-col overflow-hidden rounded-[var(--radius)] border border-line bg-surface', className]} {...attrs}>
  <div class="relative aspect-[16/10] overflow-hidden">
    {
      hasThemed ? (
        <Fragment>
          <img src={coverLight} alt={`${title} cover`} width="1600" height="1000" loading="lazy" decoding="async" class:list={['block dark:hidden', imgClass]} />
          <img src={coverDark} alt={`${title} cover`} width="1600" height="1000" loading="lazy" decoding="async" class:list={['hidden dark:block', imgClass]} />
        </Fragment>
      ) : cover ? (
        <img src={cover} alt={`${title} cover`} width="1600" height="1000" loading="lazy" decoding="async" class={imgClass} />
      ) : (
        <div class="ph absolute inset-0 flex items-center justify-center transition-transform duration-[var(--motion-hover)] ease-[var(--ease-out)] group-hover:scale-[1.03]">
          <Eyebrow tone="ph" as="span">[ cover ]</Eyebrow>
        </div>
      )
    }
    <span class="pointer-events-none absolute inset-0 bg-black/5 opacity-0 transition-opacity duration-[var(--motion-hover)] ease-[var(--ease-out)] group-hover:opacity-100"></span>
  </div>
  <div class="flex min-w-0 flex-1 flex-col gap-3 p-6 sm:p-7">
    <Eyebrow tone="accent">{kicker}</Eyebrow>
    <h3 class="t-section text-ink">{title}</h3>
    <p class="t-small text-muted">{time} &middot; {role}</p>
    <p class="t-body text-body">{desc}</p>
    <span class="t-body mt-auto inline-flex items-center gap-1.5 font-medium text-ink">
      <span class="link-underline">Read case</span>
      <span class="icon transition-transform group-hover:translate-x-1">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    </span>
  </div>
</a>
