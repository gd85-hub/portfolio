---
import Eyebrow from '../Eyebrow.astro';

interface Props {
  image: string | null;
  alt: string;
  caption?: string;
  heading?: string;
  problem?: string;
  solution?: string;
}

const { image, alt, caption, heading, problem, solution } = Astro.props;
const hasProblemSolution = Boolean(problem || solution);
---

<figure class="pb-2 sm:pb-4">
  {
    image ? (
      <img src={image} alt={alt} data-zoomable class="h-auto w-full cursor-pointer rounded-[var(--radius)] border border-line" />
    ) : (
      <div class="ph aspect-[16/9] w-full overflow-hidden rounded-[var(--radius)] border border-line">
        <div class="flex h-full items-center justify-center">
          <Eyebrow tone="ph" as="span">[ image ]</Eyebrow>
        </div>
      </div>
    )
  }
  {
    hasProblemSolution ? (
      <figcaption class="mx-auto mt-6 max-w-[70ch] text-left">
        {heading && <h3 class="t-sub text-ink">{heading}</h3>}
        <div class:list={['space-y-5', heading && 'mt-5']}>
          {
            problem && (
              <div>
                <Eyebrow tone="inherit" class="text-callout-problem-accent">Problem</Eyebrow>
                <p class="mt-2 t-body text-body">{problem}</p>
              </div>
            )
          }
          {
            solution && (
              <div>
                <Eyebrow tone="accent">Solution</Eyebrow>
                <p class="mt-2 t-body text-body">{solution}</p>
              </div>
            )
          }
        </div>
      </figcaption>
    ) : (
      caption && <figcaption class="mt-3 max-w-[70ch] t-small text-muted">{caption}</figcaption>
    )
  }
</figure>
