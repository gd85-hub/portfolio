---
interface Props {
  email: string;
  class?: string;
}

const {
  email,
  class: className = 't-body text-ink',
} = Astro.props;
---

<span
  role="button"
  tabindex="0"
  aria-label="Copy email address"
  class:list={['copy-email group relative inline-flex cursor-pointer font-mono', className]}
  data-copy-email={email}
>
  <span class="link-underline">Email</span>
  <span class="copy-tooltip" aria-hidden="true">
    <span class="copy-face copy-face-default">
      <svg class="copy-ico" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="11" height="11" rx="2" />
        <path d="M5 15V5a2 2 0 0 1 2-2h10" />
      </svg>
      Copy
    </span>
    <span class="copy-face copy-face-copied">
      <svg class="copy-check" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path pathLength="1" d="M20 6 9 17l-5-5" />
      </svg>
      Copied
    </span>
  </span>
  <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
</span>

<style>
  .copy-tooltip{
    position:absolute; bottom:100%; left:50%; margin-bottom:10px;
    display:inline-flex; align-items:center;
    padding:9px 16px; border-radius:9999px;
    background:var(--ink); color:var(--paper);
    font-size:14px; font-weight:500; line-height:1; white-space:nowrap;
    pointer-events:none; opacity:0;
    transform:translate(-50%,6px) scale(.9); transform-origin:bottom center;
    box-shadow:0 10px 28px -10px rgba(0,0,0,.4);
    transition:
      opacity 180ms var(--ease-out),
      transform 220ms cubic-bezier(0.34, 1.45, 0.64, 1),
      background-color 180ms ease,
      color 180ms ease;
  }
  .copy-face{ display:inline-flex; align-items:center; gap:7px; }
  .copy-face-copied{ display:none; }

  @media (hover:hover) and (pointer:fine){
    .copy-email:hover .copy-tooltip{ opacity:1; transform:translate(-50%,0) scale(1); }
  }
  .copy-email:focus-visible .copy-tooltip{ opacity:1; transform:translate(-50%,0) scale(1); }

  .copy-email.is-copied .copy-tooltip{
    opacity:1; transform:translate(-50%,0) scale(1);
    background:var(--accent); color:var(--on-accent);
    animation:copy-pop 260ms var(--ease-out);
  }
  .copy-email.is-copied .copy-face-default{ display:none; }
  .copy-email.is-copied .copy-face-copied{ display:inline-flex; }

  .copy-check path{ stroke-dasharray:1; stroke-dashoffset:1; }
  .copy-email.is-copied .copy-check path{ stroke-dashoffset:0; transition:stroke-dashoffset 340ms var(--ease-out) 80ms; }

  @keyframes copy-pop{
    0%{ transform:translate(-50%,0) scale(1); }
    45%{ transform:translate(-50%,0) scale(1.06); }
    100%{ transform:translate(-50%,0) scale(1); }
  }

  @media (prefers-reduced-motion:reduce){
    .copy-tooltip{ transform:translate(-50%,0) scale(1);
      transition:opacity 180ms ease, background-color 180ms ease, color 180ms ease; }
    .copy-email.is-copied .copy-tooltip{ animation:none; }
    .copy-check path{ transition:none; stroke-dashoffset:0; }
  }
</style>

<script>
  const timers = new WeakMap<HTMLElement, number>();

  const setCopied = (trigger: HTMLElement, copied: boolean) => {
    trigger.classList.toggle('is-copied', copied);
    const status = trigger.querySelector<HTMLElement>('[data-copy-status]');
    if (status) status.textContent = copied ? 'Email copied' : '';
  };

  const flashCopied = (trigger: HTMLElement) => {
    const prev = timers.get(trigger);
    if (prev) window.clearTimeout(prev);
    setCopied(trigger, true);
    const t = window.setTimeout(() => {
      setCopied(trigger, false);
      timers.delete(trigger);
    }, 1400);
    timers.set(trigger, t);
  };

  const copyEmail = async (trigger: HTMLElement) => {
    const value = trigger.dataset.copyEmail;
    if (!value || !navigator.clipboard?.writeText) return;
    try {
      await navigator.clipboard.writeText(value);
      flashCopied(trigger);
    } catch {
      /* clipboard may be unavailable */
    }
  };

  if (!(window as typeof window & { copyEmailReady?: boolean }).copyEmailReady) {
    (window as typeof window & { copyEmailReady?: boolean }).copyEmailReady = true;

    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element).closest<HTMLElement>('[data-copy-email]');
      if (trigger) copyEmail(trigger);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const trigger = (event.target as Element).closest<HTMLElement>('[data-copy-email]');
      if (!trigger) return;
      event.preventDefault();
      copyEmail(trigger);
    });
  }
</script>
