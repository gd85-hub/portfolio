---
import WorkCard from '../WorkCard.astro';
import { caseStudies } from '../../data/cases';
---

<section id="work" class="mx-auto max-w-wide scroll-mt-20 px-5 py-16 sm:px-8">
  <h2 class="reveal mb-10 t-section text-ink">Selected work</h2>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    {
      caseStudies.map((caseStudy) => (
        <WorkCard
          href={`/case/${caseStudy.slug}`}
          kicker={caseStudy.kicker}
          title={caseStudy.title}
          desc={caseStudy.cardDesc}
          time={caseStudy.time}
          role={caseStudy.role}
          coverLight={caseStudy.coverLight}
          coverDark={caseStudy.coverDark}
          cover={caseStudy.cover}
        />
      ))
    }
  </div>
</section>
