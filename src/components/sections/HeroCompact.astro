---

<section class="mx-auto max-w-content px-5 pb-8 pt-12 sm:px-8 sm:pt-16">
  <div class="hero-reveal mx-auto flex max-w-3xl flex-col items-center gap-5 text-center sm:flex-row sm:gap-6 sm:text-left" data-hero-reveal>
    <img
      src="/gleb-photo.png"
      alt="Gleb Dvoryatkin"
      width="96"
      height="96"
      loading="eager"
      decoding="async"
      class="hero-reveal-subtitle h-20 w-20 shrink-0 rounded-full object-cover ring-1 ring-line sm:h-24 sm:w-24"
    />
    <p class="hero-reveal-subtitle t-lede max-w-[54ch] text-body">
      I'm Gleb, a product designer specializing in complex interfaces and high-load B2B SaaS. 6+ years in product design across fintech, analytics, and edtech, built on a decade in marketing and research.
    </p>
  </div>
</section>

<script is:inline>
  const hero = document.querySelector('[data-hero-reveal]');
  if (hero instanceof HTMLElement && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    hero.classList.add('hero-reveal-ready');
    requestAnimationFrame(() => hero.classList.add('hero-reveal-visible'));
  }
</script>
