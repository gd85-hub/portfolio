---

<section class="mx-auto max-w-wide px-5 pb-8 pt-12 sm:px-8 sm:pt-16">
  <div class="hero-reveal mx-auto flex max-w-3xl flex-col items-center gap-6 text-center sm:flex-row sm:gap-8 sm:text-left" data-hero-reveal>
    <img
      src="/gleb-photo-light.png"
      alt="Gleb Dvoryatkin"
      width="128"
      height="128"
      loading="eager"
      decoding="async"
      class="hero-reveal-subtitle block h-28 w-28 shrink-0 rounded-full object-cover ring-1 ring-line dark:hidden sm:h-32 sm:w-32"
    />
    <img
      src="/gleb-photo-dark.png"
      alt="Gleb Dvoryatkin"
      width="128"
      height="128"
      loading="eager"
      decoding="async"
      class="hero-reveal-subtitle hidden h-28 w-28 shrink-0 rounded-full object-cover ring-1 ring-white/[0.06] dark:block sm:h-32 sm:w-32"
    />
    <p class="hero-reveal-subtitle max-w-[54ch] text-lg leading-[1.55] text-body sm:text-xl">
      I'm Gleb, a product designer specializing in complex interfaces and high-load B2B SaaS. 6+ years in product design across fintech, analytics, and edtech, built on a decade in marketing and research.
    </p>
  </div>
</section>

<script is:inline>
  const hero = document.querySelector('[data-hero-reveal]');
  if (hero instanceof HTMLElement && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    hero.classList.add('hero-reveal-ready');
    requestAnimationFrame(() => hero.classList.add('hero-reveal-visible'));
  }
</script>
